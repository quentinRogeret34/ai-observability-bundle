{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% macro icon() %}
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
{% endmacro %}

{% block toolbar %}
    {% if collector.spans is not empty %}
        {% set icon %}
            {{ _self.icon() }}
            <span class="sf-toolbar-value">{{ collector.spans|length }}</span>
            <span class="sf-toolbar-label">spans</span>
        {% endset %}
        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Spans</b>
                <span>{{ collector.spans|length }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Tokens</b>
                <span>{{ collector.inputTokens }} in / {{ collector.outputTokens }} out</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Errors</b>
                <span class="sf-toolbar-status {{ collector.errorCount ? 'sf-toolbar-status-red' }}">{{ collector.errorCount }}</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: collector.errorCount ? 'red' : ''}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.spans is empty ? 'disabled' }} {{ collector.errorCount ? 'label-status-error' }}">
        <span class="icon">{{ _self.icon() }}</span>
        <strong>AI traces</strong>
        {% if collector.errorCount %}
            <span class="count"><span>{{ collector.errorCount }}</span></span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>AI traces</h2>

    {% if collector.spans is empty %}
        <div class="empty empty-panel">
            <p>No span was recorded.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.spans|length }}</span>
                <span class="label">Spans</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.inputTokens }}</span>
                <span class="label">Input tokens</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.outputTokens }}</span>
                <span class="label">Output tokens</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.errorCount }}</span>
                <span class="label">Errors</span>
            </div>
        </div>

        <h3>Traces</h3>
        <ul>
            {% for trace_id, url in collector.traces %}
                <li>
                    {% if url %}<a href="{{ url }}" target="_blank" rel="noopener">{{ trace_id }}</a>{% else %}<code>{{ trace_id }}</code>{% endif %}
                </li>
            {% endfor %}
        </ul>

        <h3>Spans</h3>
        <table>
            <thead>
                <tr>
                    <th>Span</th>
                    <th>Kind</th>
                    <th class="text-right">Duration</th>
                    <th class="text-right">Tokens</th>
                    <th>Attributes</th>
                </tr>
            </thead>
            <tbody>
                {% for span in collector.spans %}
                    <tr class="{{ span.error is not null ? 'status-error' }}">
                        <td class="font-normal" style="padding-left: {{ 8 + span.depth * 20 }}px">
                            {{ span.name }}
                            {% if span.error is not null %}<br><span class="text-small text-danger">{{ span.error ?: 'error' }}</span>{% endif %}
                        </td>
                        <td>{{ span.kind ?? '-' }}</td>
                        <td class="text-right nowrap">{{ span.duration is null ? 'not ended' : '%0.1f ms'|format(span.duration) }}</td>
                        <td class="text-right nowrap">
                            {% if span.attributes['gen_ai.usage.input_tokens'] is defined %}
                                {{ span.attributes['gen_ai.usage.input_tokens'] }} / {{ span.attributes['gen_ai.usage.output_tokens'] ?? 0 }}
                            {% else %}-{% endif %}
                        </td>
                        <td>
                            <details>
                                <summary>{{ span.attributes|length }} attributes</summary>
                                <table>
                                    {% for key, value in span.attributes %}
                                        <tr>
                                            <th class="font-normal">{{ key }}</th>
                                            <td class="text-small"><pre class="break-long-words" style="white-space: pre-wrap">{{ value is iterable or value is same as(true) or value is same as(false) ? value|json_encode : value }}</pre></td>
                                        </tr>
                                    {% endfor %}
                                </table>
                            </details>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
